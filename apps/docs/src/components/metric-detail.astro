---
// Le corps d'UNE metrique (maquette Docs v3) : texte et encarts a gauche, exemple JSON a droite.
// Le titre reste un vrai `##` dans le MDX, avec son ancre epinglee (`## Jitter [#jitter_ms]`) :
// c'est lui qui alimente le sommaire. Ce composant ne rend donc ni titre ni `id`.
import { METRICS } from '@/lib/metrics-data';
import { tokenizeJson } from '@/lib/json-tokens';
import CodePanel from './code-panel.astro';

interface Props {
  field: string;
}
const m = METRICS.find((metric) => metric.field === Astro.props.field);
if (!m) throw new Error(`MetricDetail: metrique inconnue "${Astro.props.field}"`);
---

<div class="not-content grid gap-8 min-[1100px]:grid-cols-2">
  <div class="flex flex-col gap-4">
    <span class="font-mono text-12 text-faint">{m.field} · {m.unit}</span>
    <p class="m-0 text-16 leading-6 text-body text-pretty">{m.body}</p>
    <dl class="m-0 grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-2 rounded-sm bg-sunken p-4 text-14">
      <dt class="text-faint">Default</dt>
      <dd class="m-0 font-mono text-danger">{m.threshold}</dd>
      <dt class="text-faint">Scope</dt>
      <dd class="m-0 text-body">{m.scope}</dd>
      <dt class="text-faint">Breaks</dt>
      <dd class="m-0 text-body">{m.breaks}</dd>
    </dl>
    <div class="flex gap-3 rounded-sm border border-accent-border bg-accent-tint p-4">
      <svg class="mt-0.5 flex-none fill-none stroke-accent" width="16" height="16" viewBox="0 0 256 256" aria-hidden="true">
        <path d="M96 208h64M104 176h48a64 64 0 1 0-48 0z" stroke-width="18" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <p class="m-0 text-14 leading-5 text-body"><span class="font-semibold text-strong">What to do. </span>{m.action}</p>
    </div>
  </div>
  <CodePanel label="peer.json" lines={m.sample.map(tokenizeJson)} class="self-start min-[1100px]:sticky min-[1100px]:top-24" />
</div>
