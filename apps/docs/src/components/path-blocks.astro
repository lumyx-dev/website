---
// Accueil de la doc : les trois parcours. Une entree `soon` est grisee, sans lien.
type Item = { label: string; href?: string };
const BLOCKS: { title: string; body: string; icon: string; items: Item[] }[] = [
  {
    title: 'Run',
    body: 'Put the forwarder on a machine that peers can reach.',
    icon: 'M3 6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3zM7 10l3 2-3 2M13 14h4',
    items: [
      { label: 'Quickstart', href: '/quickstart' },
      { label: 'Self-hosting', href: '/self-hosting' },
      { label: 'Configuration', href: '/config' },
    ],
  },
  {
    title: 'Connect',
    body: 'Drive it from a browser with JSON over a WebSocket.',
    icon: 'M4 12h4l3-7 3 14 3-7h3',
    items: [
      { label: 'Signaling protocol', href: '/signaling' },
      { label: 'Rooms and sessions' },
      { label: 'Peers and tracks' },
    ],
  },
  {
    title: 'Observe',
    body: 'Read the counters the forwarder keeps today.',
    icon: 'M4 19V5M4 19h16M8 15l3-4 3 2 4-6',
    items: [
      { label: 'GET /metrics', href: '/metrics' },
      { label: 'Endpoints', href: '/endpoints' },
      { label: 'Quality metrics' },
      { label: 'Alerting' },
    ],
  },
];
---

<section class="not-content lumyx-paths" aria-label="Find your way">
  <p class="lumyx-paths-title">Find your way</p>
  <div class="lumyx-paths-grid">
    {
      BLOCKS.map((b) => (
        <div class="lumyx-path">
          <h3>
            <span class="lumyx-path-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={b.icon} />
              </svg>
            </span>
            {b.title}
          </h3>
          <p>{b.body}</p>
          <ul>
            {b.items.map((i) =>
              i.href ? (
                <li><a href={i.href}>{i.label}</a></li>
              ) : (
                <li class="lumyx-path-soon">
                  {i.label}
                  <span>Soon</span>
                </li>
              ),
            )}
          </ul>
        </div>
      ))
    }
  </div>
</section>
