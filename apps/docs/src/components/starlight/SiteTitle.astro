---
// Le wordmark Lumyx, qui renvoie vers lumyx.dev, suivi de « Docs » en retrait (maquette Docs v3).
import { Wordmark } from '@lumyx/ui';
import { SITE_URL } from '@/lib/env';
---

<a href={SITE_URL} class="site-title" aria-label="Lumyx home">
  <Wordmark />
</a>
<span class="site-title-docs" aria-hidden="true">Docs</span>

<style>
  .site-title {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .site-title-docs {
    margin-inline-start: 0.5rem;
    font-size: var(--text-16);
    line-height: 1.5;
    color: var(--text-faint);
  }
</style>
