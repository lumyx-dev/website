---
// Remplace les icones sociales de Starlight par la barre de liens de la maquette Docs v3 :
// retour au site et GitHub (la version est dans SiteTitle). Le bouton de theme suit, rendu par Starlight.
import { SITE_URL } from '@/lib/env';
import { REPO } from '@/lib/site-data';
---

<nav aria-label="Lumyx" class="lumyx-links">
  <a href={SITE_URL}>Product</a>
  <a href={REPO}>GitHub</a>
</nav>

<style>
  .lumyx-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: var(--text-14);
  }
  a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 500ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  a:hover {
    color: var(--text-strong);
  }
</style>
