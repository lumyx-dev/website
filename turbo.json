{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV", "VERCEL_ENV", "NEXT_PUBLIC_SITE_URL", "NEXT_PUBLIC_DOCS_URL", "NEXT_PUBLIC_PLAUSIBLE_DOMAIN", "CLOUD_APP_URL"],
  "globalPassThroughEnv": ["CI", "VERCEL", "VERCEL_URL"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "start": { "dependsOn": ["build"], "cache": false, "persistent": true },
    "lint": { "inputs": ["$TURBO_DEFAULT$", "eslint.config.mjs"] },
    "check-types": {},
    "test": {},
    "verify:ds": { "cache": false }
  }
}
